{
  "name": "djdesk-electron",
  "version": "0.1.0",
  "description": "DJDesk Electron Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:drawer": "node smoke/inspector-notebooks.cjs",
    "test:schema": "node smoke/inspector-schema.cjs",
    "test:schema:headless": "node smoke/inspector-schema.cjs --headless",
    "bundle": "node build-django.js",
    "build": "npm run bundle && electron-builder",
    "smoke": "node smoke/shell.cjs"
  },
  "homepage": "https://github.com/ephes/djdesk",
  "author": {
    "name": "DJDesk Team",
    "email": "team@djdesk.invalid"
  },
  "license": "ISC",
  "devDependencies": {
    "cytoscape": "3.27.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "1.65.0"
  },
  "dependencies": {
    "get-port": "^7.1.0",
    "toml": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
